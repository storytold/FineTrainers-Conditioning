                "--validation_pose_videos",
                "/home/ubuntu/upstream/finetrainers/video-dataset-pose-test/poses/stasyq-375-Scene-021-pose.mp4",
                "--validation_img_ref_videos",
                "/home/ubuntu/upstream/finetrainers/video-dataset-pose-test/videos/stasyq-375-Scene-021.mp4",
                "--num_validation_videos",
                "1",
                "--validation_steps",
                "500",
                "--tracker_name",
                "finetrainers-ltxv",
                "--output_dir",
                "ltx-video/ltxv_strip",
                "--nccl_timeout",
                "1800",
                "--report_to",
                "wandb",
                "--resume_from_checkpoint=latest"
            ],
            "justMyCode": false
        }
    ]
