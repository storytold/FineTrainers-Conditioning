{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug train.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "console": "integratedTerminal",
            "env": {
                "WANDB_MODE": "online",
                "NCCL_P2P_DISABLE": "1",
                "TORCH_NCCL_ENABLE_MONITORING": "0",
                "FINETRAINERS_LOG_LEVEL": "DEBUG",
                "CUDA_VISIBLE_DEVICES": "0"
            },
            "args": [
                "--model_name",
                "ltx_video",
                "--pretrained_model_name_or_path",
                "Lightricks/LTX-Video",
                "--data_root",
                "${workspaceFolder}/video-dataset-pose-test",
                "--video_column",
                "videos.txt",
                "--caption_column",
                "prompts.txt",
                "--pose_column",
                "poses.txt",
                "--flow_weighting_scheme",
                "logit_normal",
                "--id_token",
                "",
                "--video_resolution_buckets",
                "96x512x768",
                "--caption_dropout_p",
                "0.05",
                "--dataloader_num_workers",
