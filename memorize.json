                "--seed",
                "42",
                "--mixed_precision",
                "bf16",
                "--batch_size",
                "1",
                "--train_steps",
                "100000",
                "--target_modules",
                "to_q",
                "to_k",
                "to_v",
                "to_out.0",
                "--gradient_accumulation_steps",
